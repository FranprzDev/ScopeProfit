generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 client
 professional
}
enum ProjectStatus {
 draft
 in_review
 changes_requested
 approved
 delivered
 archived
}
enum AgentStatus {
 idle
 pending
 running
 failed
 agent_configuration_required
}
enum ChangeClassification {
 in_scope
 out_of_scope
 ambiguous
}
enum ChangeRequestStatus {
 proposed
 accepted
 rejected
}
enum QuoteStatus {
 draft
 sent
 accepted
 rejected
}
enum MaintenanceStatus {
 active
 paused
 ended
}
model User {
 id String @id @default(uuid()) @db.Uuid
 email String? @unique
 telegramId String? @unique @map("telegram_id")
 role Role @default(client)
 encryptedApiKey String? @map("encrypted_api_key")
 createdAt DateTime @default(now()) @map("created_at")
 sessions Session[]
 projects Project[]
 changeRequests ChangeRequest[]
 rateCards RateCard[]
 @@map("users")
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique @map("token_hash")
 userId String @db.Uuid @map("user_id")
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime @map("expires_at")
 revokedAt DateTime? @map("revoked_at")
 @@index([expiresAt])
 @@map("sessions")
}
model MagicLink {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique @map("token_hash")
 email String
 projectId String? @db.Uuid @map("project_id")
 linkToken String? @map("link_token")
 expiresAt DateTime @map("expires_at")
 usedAt DateTime? @map("used_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([email,createdAt])
 @@map("magic_links")
}
model AdminNonce {
 nonce String @id
 userId String @db.Uuid @map("user_id")
 projectId String @db.Uuid @map("project_id")
 expiresAt DateTime @map("expires_at")
 usedAt DateTime? @map("used_at")
 @@map("admin_nonces")
}
model Project {
 id String @id @default(uuid()) @db.Uuid
 name String
 ownerId String @db.Uuid @map("owner_id")
 owner User @relation(fields:[ownerId],references:[id])
 clientEmail String? @map("client_email")
 status ProjectStatus @default(draft)
 agentStatus AgentStatus @default(idle) @map("agent_status")
 agentStartedAt DateTime? @map("agent_started_at")
 agentError String? @map("agent_error")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 links ProjectLink[]
 messages Message[]
 files File[]
 brief Brief?
 briefVersions BriefVersion[]
 document Document?
 changeRequests ChangeRequest[]
 quote Quote?
 maintenance MaintenanceAgreement?
 @@index([ownerId])
 @@index([clientEmail])
 @@index([status])
 @@map("projects")
}
model ChangeRequest {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 actorId String? @db.Uuid @map("actor_id")
 actor User? @relation(fields:[actorId],references:[id])
 baseBriefVersion Int @map("base_brief_version")
 request String
 classification ChangeClassification
 status ChangeRequestStatus @default(proposed)
 minHours Int? @map("min_hours")
 maxHours Int? @map("max_hours")
 maintenanceEntries MaintenanceEntry[]
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([projectId,createdAt])
 @@map("change_requests")
}
model ProjectLink {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 tokenHash String @unique @map("token_hash")
 encryptedToken String @map("encrypted_token")
 expiresAt DateTime? @map("expires_at")
 revokedAt DateTime? @map("revoked_at")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([projectId])
 @@map("project_links")
}
model Message {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 threadId String @map("thread_id")
 authorId String? @map("author_id")
 authorRole String @map("author_role")
 content String
 externalId String? @unique @map("external_id")
 createdAt DateTime @default(now()) @map("created_at")
 files File[]
 @@index([projectId,createdAt,id])
 @@map("messages")
}
model File {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 messageId String? @db.Uuid @map("message_id")
 message Message? @relation(fields:[messageId],references:[id])
 name String
 mimeType String @map("mime_type")
 size Int
 path String
 checksum String
 createdAt DateTime @default(now()) @map("created_at")
 @@index([projectId])
 @@map("files")
}
model Brief {
 projectId String @id @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 version Int @default(0)
 data Json
 updatedAt DateTime @updatedAt @map("updated_at")
 @@map("briefs")
}
model BriefVersion {
 id String @id @default(uuid()) @db.Uuid
 projectId String @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 version Int
 data Json
 source String
 actorId String? @map("actor_id")
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([projectId,version])
 @@map("brief_versions")
}
model Document {
 id String @id @default(uuid()) @db.Uuid
 projectId String @unique @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 currentVersion Int @default(0) @map("current_version")
 versions DocumentVersion[]
 @@map("documents")
}
model DocumentVersion {
 id String @id @default(uuid()) @db.Uuid
 documentId String @db.Uuid @map("document_id")
 document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
 version Int
 briefVersion Int @map("brief_version")
 data Json
 editorContent Json? @map("editor_content")
 status String @default("draft")
 artifacts Json
 approvedBy String? @map("approved_by")
 approvedAt DateTime? @map("approved_at")
 deliveredAt DateTime? @map("delivered_at")
 deliveryKey String? @unique @map("delivery_key")
 createdAt DateTime @default(now()) @map("created_at")
 @@unique([documentId,version])
 @@map("document_versions")
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 projectId String? @db.Uuid @map("project_id")
 actorId String? @map("actor_id")
 action String
 result String
 metadata Json?
 createdAt DateTime @default(now()) @map("created_at")
 @@index([projectId,createdAt])
 @@map("audit_events")
}
model TelegramUpdate {
 id String @id
 status String
 createdAt DateTime @default(now()) @map("created_at")
 @@map("telegram_updates")
}
model TelegramState {
 userId String @id @map("user_id")
 projectId String? @map("project_id")
 action String
 expiresAt DateTime @map("expires_at")
 @@map("telegram_states")
}
model RateCard {
 id String @id @default(uuid()) @db.Uuid
 ownerId String @db.Uuid @map("owner_id")
 owner User @relation(fields:[ownerId],references:[id])
 label String
 hourlyRate Decimal @map("hourly_rate") @db.Decimal(12,2)
 currency String @default("USD")
 marginPercent Int @default(0) @map("margin_percent")
 isDefault Boolean @default(false) @map("is_default")
 active Boolean @default(true)
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([ownerId])
 @@map("rate_cards")
}
model Quote {
 id String @id @default(uuid()) @db.Uuid
 projectId String @unique @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 status QuoteStatus @default(draft)
 currency String @default("USD")
 subtotalMin Decimal @map("subtotal_min") @db.Decimal(12,2)
 subtotalMax Decimal @map("subtotal_max") @db.Decimal(12,2)
 totalMin Decimal @map("total_min") @db.Decimal(12,2)
 totalMax Decimal @map("total_max") @db.Decimal(12,2)
 validUntil DateTime? @map("valid_until")
 terms String?
 rateCardSnapshot Json? @map("rate_card_snapshot")
 sentAt DateTime? @map("sent_at")
 decidedAt DateTime? @map("decided_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 lines QuoteLine[]
 milestones QuoteMilestone[]
 @@index([status])
 @@map("quotes")
}
model QuoteLine {
 id String @id @default(uuid()) @db.Uuid
 quoteId String @db.Uuid @map("quote_id")
 quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade)
 module String
 minHours Int @map("min_hours")
 maxHours Int @map("max_hours")
 hourlyRate Decimal @map("hourly_rate") @db.Decimal(12,2)
 priceMin Decimal @map("price_min") @db.Decimal(12,2)
 priceMax Decimal @map("price_max") @db.Decimal(12,2)
 position Int @default(0)
 @@index([quoteId])
 @@map("quote_lines")
}
model QuoteMilestone {
 id String @id @default(uuid()) @db.Uuid
 quoteId String @db.Uuid @map("quote_id")
 quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade)
 name String
 percent Int?
 amount Decimal? @db.Decimal(12,2)
 position Int @default(0)
 @@index([quoteId])
 @@map("quote_milestones")
}
model MaintenanceAgreement {
 id String @id @default(uuid()) @db.Uuid
 projectId String @unique @db.Uuid @map("project_id")
 project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
 status MaintenanceStatus @default(active)
 hoursPerMonth Decimal @map("hours_per_month") @db.Decimal(6,2)
 monthlyPrice Decimal? @map("monthly_price") @db.Decimal(12,2)
 currency String @default("USD")
 startDate DateTime @map("start_date")
 endDate DateTime? @map("end_date")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 entries MaintenanceEntry[]
 @@index([status])
 @@map("maintenance_agreements")
}
model MaintenanceEntry {
 id String @id @default(uuid()) @db.Uuid
 agreementId String @db.Uuid @map("agreement_id")
 agreement MaintenanceAgreement @relation(fields:[agreementId],references:[id],onDelete:Cascade)
 changeRequestId String? @db.Uuid @map("change_request_id")
 changeRequest ChangeRequest? @relation(fields:[changeRequestId],references:[id],onDelete:SetNull)
 date DateTime
 hours Decimal @db.Decimal(6,2)
 description String
 billableExtra Boolean @default(false) @map("billable_extra")
 createdAt DateTime @default(now()) @map("created_at")
 @@index([agreementId])
 @@index([changeRequestId])
 @@map("maintenance_entries")
}
