{
  "name": "@scopeprofit/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "start": "node dist/src/main.js",
    "dev": "prisma generate && tsc-watch -p tsconfig.json --onSuccess \"node dist/src/main.js\"",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "tsx --test test/unit.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "test:e2e": "npm run build && node --test dist/test/e2e.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@langchain/core": "^1.1.0",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.19.0",
    "@scopeprofit/contracts": "1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "docx": "^9.5.1",
    "grammy": "^1.30.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "^0.17.3",
    "eslint": "^9.39.1",
    "prisma": "^6.19.0",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
