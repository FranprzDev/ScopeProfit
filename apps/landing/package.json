{
  "name": "@scopeprofit/landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "PORT=3000 node scripts/dev.mjs",
    "dev:direct": "next dev -p 3000 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:smoke",
    "test:unit": "tsx --test test/tool-finder.test.ts test/content.test.ts",
    "test:smoke": "tsx --test test/smoke.test.ts",
    "test:coverage": "c8 pnpm run test:unit"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.61.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "c8": "^10.1.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
