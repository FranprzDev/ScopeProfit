POSTGRES_USER=scopeprofit
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=scopeprofit
DATABASE_URL=postgresql://scopeprofit:replace-with-a-long-random-password@localhost:5432/scopeprofit
PORT=3001
WEB_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
# Public HTTPS origin where the API (and the MCP server at /api/mcp) is reachable directly.
# OAuth discovery lives at its root, so it must not be the Next.js proxy.
PUBLIC_API_URL=http://localhost:3001
MCP_DOMAIN=
# Set to the number of reverse-proxy hops in front of the API (usually 1) so rate limits see client IPs.
TRUST_PROXY_HOPS=
STORAGE_ROOT=./storage
ENCRYPTION_KEY=
SESSION_SECRET=
AI_PROVIDER=google
AI_MODEL=gemini-3.8-flash
AI_GATEWAY_API_KEY=replace-with-vercel-ai-gateway-key
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Scope-to-Profit
ADMIN_EDIT_URL_TTL_DAYS=10
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Landing analytics (optional, cookieless Plausible). Set both at build time to enable, or leave both empty.
# Example: NEXT_PUBLIC_PLAUSIBLE_DOMAIN=scopeprofit.app and NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
# MCP server
# Requests per minute per IP on /api/mcp.
MCP_RATE_LIMIT_PER_MINUTE=120
# Lifetime of the signed download links returned by export_document / approve_scope.
MCP_EXPORT_URL_TTL_MINUTES=60
# Local stdio server only: API key the stdio process acts as (create with `mcp:keys create`).
SCOPEPROFIT_API_KEY=
# Testing only, never in production: allow http:// and private-network image URLs in add_client_input.
MCP_ALLOW_HTTP_IMAGE_URLS=false
MCP_ALLOW_PRIVATE_IMAGE_URLS=false
# Export diagram rendering: clean (default) or sketch (hand-drawn pencil style).
DIAGRAM_STYLE=clean
# Export PDF brand name shown on the cover and interior headers; default ScopeProfit.
EXPORT_BRAND_NAME=
# Export PDF brand tagline shown under the cover brand name; empty omits the line.
EXPORT_BRAND_TAGLINE=
# Export PDF brand color for headings and the section rules (hex #rrggbb); default #1d4ed8.
EXPORT_BRAND_ACCENT=
# Export PDF brand color for the title bar and bullet dots (hex #rrggbb); defaults to the accent.
EXPORT_BRAND_ACCENT_ALT=
# Export PDF brand color for body text (hex #rrggbb); default #111827.
EXPORT_BRAND_INK=
# Export PDF brand color for secondary text (hex #rrggbb); default #4b5563.
EXPORT_BRAND_MUTED=
# Export PDF brand background for the metadata band (hex #rrggbb); default #eff4ff.
EXPORT_BRAND_BAND=
# Export PDF brand color for hairline rules (hex #rrggbb); default #d1d5db.
EXPORT_BRAND_RULE=
# IANA timezone for export dates (e.g. America/Argentina/Buenos_Aires); unset keeps UTC.
EXPORT_TIMEZONE=
