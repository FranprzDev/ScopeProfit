# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=scopeprofit
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=scopeprofit
# Neon / Vercel Postgres: use the pooled connection string. postgres:// and sslmode=require work.
DATABASE_URL=postgresql://scopeprofit:replace-with-a-long-random-password@localhost:5432/scopeprofit
# queue = long-lived server (Docker); null = serverless (Vercel), one connection per request.
DATABASE_POOL=queue

# --- API --------------------------------------------------------------------------------------
# Public HTTPS origin of the API (no path). MCP is served at {PUBLIC_API_URL}/api/mcp.
PUBLIC_API_URL=http://localhost:3001
# 32 random bytes, base64: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SIGNING_KEY=
# Number of reverse proxies in front of the API (Vercel/Render: 1) so rate limits see client IPs.
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_PER_MINUTE=120
EXPORT_URL_TTL_MINUTES=60
# Comma-separated browser origins allowed to call the REST API (empty = none).
CORS_ALLOWED_ORIGINS=

# --- Server-side scope agent (optional) -------------------------------------------------------
# worker = background loop (Docker); inline = run in the request that queued it (Vercel); off = cron only.
AGENT_MODE=worker
# Vercel AI Gateway model id. Unset = agent disabled (hosts draft the scope themselves).
AI_MODEL=
# Optional on Vercel (the deployment's OIDC token is used when this is empty).
AI_GATEWAY_API_KEY=
# Bearer secret for GET/POST /api/agent/run (Vercel Cron sends it automatically).
CRON_SECRET=

# --- Email (Brevo, optional: approved document delivery) --------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ScopeProfit

# --- Testing only, never in production ---------------------------------------------------------
ALLOW_HTTP_IMAGE_URLS=false
ALLOW_PRIVATE_IMAGE_URLS=false

# --- Landing (apps/landing) ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Landing analytics (optional, cookieless Plausible). Set both at build time to enable, or leave both empty.
# Example: NEXT_PUBLIC_PLAUSIBLE_DOMAIN=scopeprofit.app and NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
