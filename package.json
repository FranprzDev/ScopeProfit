{
  "name": "scopeprofit",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev:api": "pnpm --filter @scopeprofit/api run dev",
    "dev:landing": "pnpm --filter @scopeprofit/landing run dev",
    "dev:web": "pnpm run dev:landing",
    "build": "pnpm --filter @scopeprofit/contracts run build && pnpm --filter @scopeprofit/api run build && pnpm --filter @scopeprofit/landing run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs landing=apps/landing/coverage/lcov.info",
    "db:migrate": "pnpm --filter @scopeprofit/api run db:migrate",
    "smoke": "bash scripts/smoke.sh",
    "production:preflight": "node scripts/preflight.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,mjs,json,md,yml,yaml}\" \"packages/**/*.{ts,tsx,mjs,json,md,yml,yaml}\" \"scripts/**/*.{js,mjs,ts,json,yml,yaml}\" \"docs/**/*.md\" \"README.md\" \".github/**/*.{yml,yaml}\" \"docker-compose*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,json,md,yml,yaml}\" \"packages/**/*.{ts,tsx,mjs,json,md,yml,yaml}\" \"scripts/**/*.{js,mjs,ts,json,yml,yaml}\" \"docs/**/*.md\" \"README.md\" \".github/**/*.{yml,yaml}\" \"docker-compose*.yml\""
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.8"
  }
}
